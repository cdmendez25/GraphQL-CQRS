# Supabase → botón "Connect" → Session pooler (reemplaza [YOUR-PASSWORD])
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

PORT=4000
CORS_ORIGIN=http://localhost:5173
# Cámbiala por cualquier texto largo y aleatorio
JWT_SECRET=cambia-esto-por-un-secreto-largo

# true = consultas anidadas agrupadas en lote · false = demuestra el problema N+1
DATALOADER_ENABLED=true
# Muestra cada consulta SQL en la consola (evidencia para el video)
LOG_SQL=true

# Tiempos de la simulación asíncrona (ms)
PROJECTION_DELAY_MS=1500
AUTO_APPROVAL_DELAY_MS=3000
PRESCRIPTION_CHECK_DELAY_MS=4000
